rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // La tienda NO usa Firestore (todo va por el servidor y MySQL). Se cierra todo el acceso desde navegadores.
    // Publicar estas reglas en Firebase Console > Firestore > Reglas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
